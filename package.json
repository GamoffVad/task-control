{
  "name": "task-control",
  "private": true,
  "version": "6.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mssql": "vitest run src/test/mssql.test.ts",
    "typecheck": "tsc -b",
    "docs": "node docs/build-docs.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "deploy": "node scripts/deploy-vercel.mjs",
    "build:iis": "node scripts/build-iis.mjs",
    "build:sql": "node scripts/build-sql.mjs",
    "pack:iis": "node scripts/pack-iis.mjs"
  },
  "dependencies": {
    "mssql": "^12.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.5.0"
  }
}
