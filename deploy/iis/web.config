<?xml version="1.0" encoding="utf-8"?>
<!--
  «Контроль задач» в IIS. Значения appSettings заполняет install.ps1 при установке.
  Ключи «env:ИМЯ» передаются серверу API (Node.js) как переменные окружения.
-->
<configuration>
  <appSettings>
    <!-- true — install.ps1 включил Windows-аутентификацию IIS для адреса /api/windows-login. -->
    <add key="WindowsAuth" value="false" />
    <add key="env:MSSQL_CONNECTION_STRING" value="" />
    <add key="env:AUTH_SECRET" value="" />
    <!-- Поиск сотрудников в Active Directory (нужен модуль PowerShell ActiveDirectory из RSAT). -->
    <add key="env:AD_SEARCH_ENABLED" value="false" />
    <add key="env:AD_SEARCH_BASE" value="" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" enableVersionHeader="false" maxRequestLength="2048" />
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <modules>
      <!-- Без preCondition: модуль нужен и для статических адресов (маршруты приложения → index.html). -->
      <add name="PlanHost" type="PlanHost.Module, PlanHost" preCondition="" />
    </modules>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- bin и App_Data (сервер API, node.exe, журналы) IIS и так не отдаёт; явно — на случай изменённых настроек сервера. -->
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="bin" />
          <remove segment="App_Data" />
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Файлы сборки с хешем в имени не меняются — кешируются на год. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Service Worker уведомлений: всегда свежая версия, область действия — весь сайт. -->
  <location path="sw.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Service-Worker-Allowed" value="/" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
